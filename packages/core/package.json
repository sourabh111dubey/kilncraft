{
  "name": "@kilncraft/core",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@kilncraft/shared": "workspace:*",
    "diff": "9.0.0",
    "pino": "10.4.0",
    "tinyglobby": "0.2.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "fast-check": "4.10.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
